@using POS.Utilities.ViewModel
@model IEnumerable<ItemViewModel>
@{
    Layout = null;
}

<style>
    .raw-items-container {
        padding: 20px;
    }
    .empty-items {
        text-align: center;
        padding: 60px 20px;
        color: #718096;
    }
    .empty-items i {
        font-size: 64px;
        color: #cbd5e0;
        margin-bottom: 20px;
    }
    .price-cell {
        font-weight: 600;
        color: #28a745;
    }
</style>

<script src="~/Scripts/Site.js"></script>
<div class="raw-items-container">
    <div class="row">
        <div class="col-12">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h3><i class="fas fa-box-open"></i> Raw Items Management</h3>
                    <a href="/Vendor/RawItem" id="btn-add"
                       class="btn-modern-primary"
                       data-toggle="tooltip" data-placement="bottom" title="Add New Raw Item"
                       data-caption="Add New Raw Item">
                        <i class="fas fa-plus"></i> Add New Raw Item
                    </a>
                </div>
                <div class="modern-table-wrapper">
                    @if (Model != null && Model.Count() > 0)
                    {
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Item Name</th>
                                    <th>Category</th>
                                    <th>Department</th>
                                    <th>Price</th>
                                    <th>Tax</th>
                                    <th>Barcode</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model)
                                {
                                    <tr class="dgrow" data-id="@e.Id">
                                        <td><strong>@e.Name</strong></td>
                                        <td>@(e.CategoryName ?? "-")</td>
                                        <td>@(e.DepartmentName ?? "-")</td>
                                        <td class="price-cell">@e.Price.ToString("N2")</td>
                                        <td>@e.Tax</td>
                                        <td>@(e.Barcode ?? "-")</td>
                                        <td>
                                            <div class="action-buttons">
                                                <a href="/Vendor/RawItem/@e.Id" class="action-btn-edit" data-toggle="tooltip" data-placement="bottom" title="Edit Raw Item">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <a href="/Menu/DeleteItem/@e.Id" class="action-btn-delete" data-toggle="tooltip" data-placement="bottom" title="Delete Raw Item">
                                                    <i class="fas fa-trash"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-items">
                            <i class="fas fa-box-open"></i>
                            <h4>No Raw Items Found</h4>
                            <p>Get started by adding your first raw item.</p>
                            <a href="/Vendor/RawItem" class="btn-modern-primary" style="margin-top: 20px;">
                                <i class="fas fa-plus"></i> Add Raw Item
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
