@using POS.Utilities.ViewModel
@model IEnumerable<CustomerViewModel>
@{
    Layout = null;
}

<style>
    .customers-container {
        padding: 20px;
    }
    .empty-customers {
        text-align: center;
        padding: 60px 20px;
        color: #718096;
    }
    .empty-customers i {
        font-size: 64px;
        color: #cbd5e0;
        margin-bottom: 20px;
    }
    .status-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }
    .status-active {
        background: #d4edda;
        color: #155724;
    }
    .status-inactive {
        background: #f8d7da;
        color: #721c24;
    }
</style>

<script src="~/Scripts/Site.js"></script>
<div class="customers-container">
    <div class="row">
        <div class="col-12">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h3><i class="fas fa-users"></i> Customers Management</h3>
                    <a href="/Vendor/AddCustomer" id="btn-add"
                       class="btn-modern-primary"
                       data-toggle="tooltip" data-placement="bottom" title="Add New Customer"
                       data-caption="Add New Customer">
                        <i class="fas fa-plus"></i> Add New Customer
                    </a>
                </div>
                <div class="modern-table-wrapper">
                    @if (Model != null && Model.Count() > 0)
                    {
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Customer Name</th>
                                    <th>Car Number</th>
                                    <th>Mobile</th>
                                    <th>City</th>
                                    <th>CNIC</th>
                                    <th>Last Reading</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model)
                                {
                                    <tr class="dgrow" data-id="@e.Id">
                                        <td><strong>@e.CustomerName</strong></td>
                                        <td>@(e.CarNumber ?? "-")</td>
                                        <td>@(e.Mobile ?? "-")</td>
                                        <td>@(e.CityName ?? "-")</td>
                                        <td>@(e.CNIC ?? "-")</td>
                                        <td>@(e.Reading ?? "-")</td>
                                        <td>
                                            <span class="status-badge @(e.IsActive ? "status-active" : "status-inactive")">
                                                @(e.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="action-buttons">
                                                <a href="/Vendor/AddCustomer/@e.Id" class="action-btn-edit" data-toggle="tooltip" data-placement="bottom" title="Edit Customer">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <a href="/Vendor/DeleteCustomer/@e.Id" class="action-btn-delete" data-toggle="tooltip" data-placement="bottom" title="Delete Customer">
                                                    <i class="fas fa-trash"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-customers">
                            <i class="fas fa-users"></i>
                            <h4>No Customers Found</h4>
                            <p>Get started by adding your first customer.</p>
                            <a href="/Vendor/AddCustomer" class="btn-modern-primary" style="margin-top: 20px;">
                                <i class="fas fa-plus"></i> Add Customer
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
