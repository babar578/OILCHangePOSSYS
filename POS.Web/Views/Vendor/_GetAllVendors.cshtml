@using POS.Utilities.ViewModel
@model IEnumerable<VendorViewModel>
@{
    Layout = null;
}

<style>
    .vendors-container {
        padding: 20px;
    }
    .empty-vendors {
        text-align: center;
        padding: 60px 20px;
        color: #718096;
    }
    .empty-vendors i {
        font-size: 64px;
        color: #cbd5e0;
        margin-bottom: 20px;
    }
</style>

<script src="~/Scripts/Site.js"></script>
<div class="vendors-container">
    <div class="row">
        <div class="col-12">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h3><i class="fas fa-truck"></i> Vendors Management</h3>
                    <a href="/Vendor/AddVendor" id="btn-add"
                       class="btn-modern-primary"
                       data-toggle="tooltip" data-placement="bottom" title="Add New Vendor"
                       data-caption="Add New Vendor">
                        <i class="fas fa-plus"></i> Add New Vendor
                    </a>
                </div>
                <div class="modern-table-wrapper">
                    @if (Model != null && Model.Count() > 0)
                    {
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Vendor Name</th>
                                    <th>Contact Person</th>
                                    <th>City</th>
                                    <th>Mobile</th>
                                    <th>Email</th>
                                    <th>NTN</th>
                                    <th>Business Start Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model)
                                {
                                    <tr class="dgrow" data-id="@e.Id">
                                        <td><strong>@e.VendorName</strong></td>
                                        <td>@(e.ContactPerson ?? "-")</td>
                                        <td>@(e.CityName ?? "-")</td>
                                        <td>@(e.Mobile ?? "-")</td>
                                        <td>@(e.Email ?? "-")</td>
                                        <td>@(e.NTN ?? "-")</td>
                                        <td>@e.BusinessStartDate.ToString("dd-MMM-yyyy")</td>
                                        <td>
                                            <div class="action-buttons">
                                                <a href="/Vendor/AddVendor/@e.Id" class="action-btn-edit" data-toggle="tooltip" data-placement="bottom" title="Edit Vendor">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <a href="/Vendor/DeleteVendor/@e.Id" class="action-btn-delete" data-toggle="tooltip" data-placement="bottom" title="Delete Vendor">
                                                    <i class="fas fa-trash"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-vendors">
                            <i class="fas fa-truck"></i>
                            <h4>No Vendors Found</h4>
                            <p>Get started by adding your first vendor.</p>
                            <a href="/Vendor/AddVendor" class="btn-modern-primary" style="margin-top: 20px;">
                                <i class="fas fa-plus"></i> Add Vendor
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
