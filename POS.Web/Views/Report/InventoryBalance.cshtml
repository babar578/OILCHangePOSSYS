
@{
    ViewBag.Title = "Inventory Balance Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-balance-scale"></i> Inventory Balance Report
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#filterModal">
                        <i class="fas fa-filter"></i> Filter
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div id="InventoryBalance"></div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="filterModalLabel">
                    <i class="fas fa-filter"></i> Filter Inventory Balance
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="filterContent">
                <!-- Filter content will be loaded here -->
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script>
    $(document).ready(function () {
        GetInventoryBalance();
        
        // Load filter form when modal is opened
        $('#filterModal').on('show.bs.modal', function () {
            LoadFilterForm();
        });
    });

    function LoadFilterForm() {
        $.ajax({
            url: "/Report/FilterInventoryBalance/",
            type: "GET",
            success: function (result) {
                $("#filterContent").html(result);
                // Reinitialize selectpicker if needed
                if (typeof $().selectpicker === 'function') {
                    $('.selectpicker').selectpicker('refresh');
                }
            },
            error: function () {
                alertify.error("Error loading filter form");
            }
        });
    }

    function GetInventoryBalance() {
        startLoader();
        $.ajax({
            url: "/Report/GetInventoryBalance/",
            type: "GET"
        }).done(function (result) {
            $("#InventoryBalance").html(result);
            stopLoader();
        }).fail(function () {
            stopLoader();
            alertify.error("Error loading inventory balance report");
        });
    }
</script>





