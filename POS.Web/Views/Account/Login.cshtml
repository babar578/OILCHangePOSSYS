@using POS.Utilities.ViewModel
@model UserViewModel
@using POS.Utilities.Services
@using POS.Utilities.Utilities
@{
    ViewBag.Title = "Login";
    Layout = null;
    var companyInfo = ItemServices.GetCompanyById();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(companyInfo != null ? companyInfo.CompanyName : "Login") - AI Powered System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- External CSS -->
    <link href="~/Content/plugins/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/JqueryLoadingModal/jquery.loadingModal.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            height: 100vh;
            overflow: hidden;
            display: flex;
            background-color: #fff;
        }

        /* Left Side - AI Branding */
        .login-brand-section {
            flex: 1.2;
            background: linear-gradient(135deg, rgba(10, 25, 47, 0.95), rgba(16, 42, 67, 0.9)), url('/Content/login_background_ai_tech.png'); /* Fallback or dynamic path */
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            padding: 40px;
            position: relative;
        }

            /* Overlay for better text readability if needed */
            .login-brand-section::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: radial-gradient(circle at center, transparent 0%, #0a192f 100%);
                opacity: 0.6;
            }

        .brand-content {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 600px;
            animation: fadeIn 1s ease-out;
        }

        .brand-logo {
            font-size: 64px;
            margin-bottom: 20px;
            color: #4db5ff; /* Cyan/Blue accent */
            text-shadow: 0 0 20px rgba(77, 181, 255, 0.5);
        }

        .brand-title {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 15px;
            letter-spacing: -0.5px;
        }

        .brand-subtitle {
            font-size: 18px;
            color: #b0c4de;
            line-height: 1.6;
            font-weight: 300;
        }

        .ai-badge {
            display: inline-block;
            background: rgba(77, 181, 255, 0.15);
            border: 1px solid rgba(77, 181, 255, 0.3);
            padding: 8px 16px;
            border-radius: 50px;
            font-size: 14px;
            color: #4db5ff;
            margin-top: 30px;
            backdrop-filter: blur(5px);
        }

        /* Right Side - Login Form */
        .login-form-section {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #ffffff;
            padding: 40px;
            position: relative;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 40px;
            animation: slideUp 0.8s ease-out;
        }

        .login-header {
            margin-bottom: 40px;
        }

            .login-header h2 {
                font-size: 28px;
                font-weight: 700;
                color: #1a202c;
                margin-bottom: 10px;
            }

            .login-header p {
                color: #718096;
                font-size: 15px;
            }

        .form-group {
            margin-bottom: 25px;
            position: relative;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #4a5568;
            font-size: 14px;
        }

        .input-group {
            position: relative;
        }

            .input-group i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #a0aec0;
                transition: color 0.3s;
            }

        .form-control {
            width: 100%;
            padding: 14px 14px 14px 45px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            font-size: 15px;
            transition: all 0.3s;
            outline: none;
            background: #f7fafc;
            color: #2d3748;
            font-family: 'Inter', sans-serif;
        }

            .form-control:focus {
                border-color: #4db5ff;
                background: #fff;
                box-shadow: 0 0 0 4px rgba(77, 181, 255, 0.1);
            }

                .form-control:focus + i {
                    color: #4db5ff;
                }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            font-size: 14px;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #4a5568;
            cursor: pointer;
        }

            .remember-me input {
                width: 16px;
                height: 16px;
                accent-color: #4db5ff;
            }

        .forgot-password {
            color: #4db5ff;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

            .forgot-password:hover {
                color: #3182ce;
            }

        .btn-login {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #2b6cb0 0%, #1a365d 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 12px rgba(43, 108, 176, 0.3);
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(43, 108, 176, 0.4);
            }

            .btn-login:active {
                transform: translateY(0);
            }

        .copyright {
            position: absolute;
            bottom: 20px;
            left: 0;
            right: 0;
            text-align: center;
            color: #a0aec0;
            font-size: 12px;
        }

        /* Animations */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateX(20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* Responsive */
        @@media (max-width: 900px) {
            .login-brand-section {
                display: none;
            }

            .login-form-section {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Left Side: AI Branding -->
    <div class="login-brand-section" style="background-image: linear-gradient(135deg, rgba(10, 25, 47, 0.92), rgba(16, 42, 67, 0.85)), url('https://images.unsplash.com/photo-1518770660439-4636190af475?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');">
        <div class="brand-content">
            <div class="brand-logo">
                <i class="fas fa-brain"></i>
            </div>
            <h1 class="brand-title">Smart POS System</h1>
            <p class="brand-subtitle">
                Experience the future of inventory management with our AI-powered solution.
                Streamline your oil change store operations with intelligent insights.
            </p>
            <div class="ai-badge">
                <i class="fas fa-robot"></i> AI-Powered Engine v2.0
            </div>
        </div>
    </div>

    <!-- Right Side: Login Form -->
    <div class="login-form-section">
        <div class="login-card">
            <div class="login-header">
                @if (companyInfo != null)
                {
                    <h2>@companyInfo.CompanyNameUrdu</h2>
                }
                else
                {
                    <h2>Welcome Back</h2>
                }
                <p>Please enter your credentials to access your account.</p>
            </div>

            <div class="form-group">
                <label class="form-label" for="UserName">Username</label>
                <div class="input-group">
                    <input type="text" class="form-control" id="UserName" placeholder="Enter your username" required />
                    <i class="fas fa-user"></i>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="Password">Password</label>
                <div class="input-group">
                    <input type="password" class="form-control" id="Password" placeholder="Enter your password" required />
                    <i class="fas fa-lock"></i>
                </div>
            </div>

            <div class="form-options">
                <label class="remember-me">
                    <input type="checkbox" /> Remember me
                </label>
                <a href="#" class="forgot-password">Forgot Password?</a>
            </div>

            <button id="btn-login" class="btn-login">
                Sign In <i class="fas fa-arrow-right" style="margin-left: 8px;"></i>
            </button>
        </div>

        <div class="copyright">
            &copy; @DateTime.Now.Year POS System. All rights reserved.
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/Content/plugins/jquery/jquery.min.js"></script>
    <script src="~/Content/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/JqueryLoadingModal/jquery.loadingModal.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        // Loader handlers
        function startLoader() {
            $("body").loadingModal({
                text: 'Authenticating...',
                animation: 'wave',
                backgroundColor: 'rgba(0,0,0,0.8)',
                color: '#fff'
            });
        }
        function stopLoader() {
            $("body").loadingModal('destroy');
        }

        // Toastr config
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            showMethod: "slideDown",
            hideMethod: "fadeOut",
            timeOut: 4000
        };

        // Login logic
        $("#btn-login").click(function () {
            var userName = $("#UserName").val().trim();
            var password = $("#Password").val().trim();

            if (userName === "" || password === "") {
                toastr.error("Please enter both username and password.", "Missing Credentials");
                return;
            }

            var modelData = { UserName: userName, Password: password };
            startLoader();

            $.ajax({
                url: '@Url.Action("Login", "Account")',
                type: "POST",
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(modelData),
                success: function (res) {
                    if (res === "Success") {
                        toastr.success("Redirecting to dashboard...", "Login Successful");
                        setTimeout(function() {
                            window.location.href = "/Home/Index";
                        }, 1000);
                    } else {
                        toastr.error("Invalid username or password.", "Login Failed");
                    }
                    stopLoader();
                },
                error: function () {
                    toastr.error("An error occurred while connecting to the server.", "System Error");
                    stopLoader();
                }
            });
        });

        // Allow Enter key to submit
        $(document).keypress(function(e) {
            if(e.which == 13) {
                $("#btn-login").click();
            }
        });
    </script>
</body>
</html>
