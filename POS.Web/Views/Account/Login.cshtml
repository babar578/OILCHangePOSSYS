@using POS.Utilities.ViewModel
@model UserViewModel
@{
    ViewBag.Title = "Login - TorroSell";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>TorroSell - Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- External CSS -->
    <link href="~/Content/plugins/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/JqueryLoadingModal/jquery.loadingModal.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            height: 100vh;
            overflow: hidden;
            display: flex;
            background: #36393f; /* Dark charcoal gray like logo */
        }

        /* Left Side - TorroSell Branding */
        .login-brand-section {
            flex: 1.2;
            background: linear-gradient(135deg, #2c2f33 0%, #36393f 50%, #23272a 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            padding: 60px 40px;
            position: relative;
            overflow: hidden;
        }

        /* Animated geometric pattern background */
        .login-brand-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background-image: 
                repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(98, 114, 164, 0.03) 35px, rgba(98, 114, 164, 0.03) 70px);
            animation: movePattern 20s linear infinite;
        }

        @@keyframes movePattern {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }

        .brand-content {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 500px;
            animation: fadeInUp 0.8s ease-out;
        }

        /* Logo container */
        .brand-logo-container {
            margin-bottom: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
        }

        .bull-icon {
            width: 80px;
            height: 80px;
            background: rgba(98, 114, 164, 0.2);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            color: #6272a4;
            box-shadow: 0 8px 32px rgba(98, 114, 164, 0.2);
            border: 2px solid rgba(98, 114, 164, 0.3);
        }

        .brand-name {
            font-size: 48px;
            font-weight: 700;
            color: #8b95b0;
            letter-spacing: -1px;
        }

        .brand-tagline {
            font-size: 20px;
            color: #8b95b0;
            line-height: 1.6;
            font-weight: 300;
            margin-bottom: 30px;
        }

        .feature-list {
            text-align: left;
            margin-top: 40px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            color: #a3a9b8;
        }

        .feature-item i {
            color: #6272a4;
            margin-right: 12px;
            font-size: 18px;
        }

        /* Right Side - Login Form */
        .login-form-section {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #2c2f33;
            padding: 40px;
            position: relative;
        }

        .login-card {
            width: 100%;
            max-width: 450px;
            background: #23272a;
            padding: 50px 40px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(98, 114, 164, 0.2);
            animation: slideUp 0.8s ease-out;
        }

        .login-header {
            margin-bottom: 40px;
            text-align: center;
        }

        .login-header-logo {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .login-header-logo i {
            font-size: 36px;
            color: #6272a4;
        }

        .login-header-logo span {
            font-size: 32px;
            font-weight: 700;
            color: #8b95b0;
        }

        .login-header h2 {
            font-size: 24px;
            font-weight: 600;
            color: #e4e7eb;
            margin-bottom: 8px;
        }

        .login-header p {
            color: #8b95b0;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 25px;
            position: relative;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #8b95b0;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .input-group {
            position: relative;
        }

        .input-group i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6272a4;
            transition: color 0.3s;
            z-index: 10;
        }

        .form-control {
            width: 100%;
            padding: 15px 15px 15px 45px;
            border: 2px solid #40444b;
            border-radius: 10px;
            font-size: 15px;
            transition: all 0.3s;
            outline: none;
            background: #2c2f33;
            color: #e4e7eb;
            font-family: 'Inter', sans-serif;
        }

        .form-control:focus {
            border-color: #6272a4;
            background: #36393f;
            box-shadow: 0 0 0 4px rgba(98, 114, 164, 0.15);
        }

        .form-control:focus + i {
            color: #8b9dc3;
        }

        .form-control::placeholder {
            color: #72767d;
        }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            font-size: 13px;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #8b95b0;
            cursor: pointer;
        }

        .remember-me input {
            width: 16px;
            height: 16px;
            accent-color: #6272a4;
            cursor: pointer;
        }

        .forgot-password {
            color: #6272a4;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

        .forgot-password:hover {
            color: #8b9dc3;
        }

        .btn-login {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #5b6eae 0%, #6272a4 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 8px 24px rgba(98, 114, 164, 0.3);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(98, 114, 164, 0.4);
            background: linear-gradient(135deg, #6272a4 0%, #5b6eae 100%);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .copyright {
            position: absolute;
            bottom: 20px;
            left: 0;
            right: 0;
            text-align: center;
            color: #72767d;
            font-size: 12px;
        }

        /* Animations */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@keyframes movePattern {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        /* Responsive */
        @@media (max-width: 900px) {
            .login-brand-section {
                display: none;
            }

            .login-form-section {
                padding: 20px;
                background: #23272a;
            }

            .login-card {
                padding: 30px 25px;
            }
        }

        /* Divider */
        .divider {
            text-align: center;
            margin: 25px 0;
            position: relative;
        }

        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #40444b;
        }

        .divider span {
            background: #23272a;
            padding: 0 15px;
            color: #72767d;
            font-size: 12px;
            position: relative;
            z-index: 1;
        }
    </style>
</head>
<body>
    <!-- Left Side: TorroSell Branding -->
    <div class="login-brand-section">
        <div class="brand-content">
            <!-- TorroSell Logo -->
            <div class="brand-logo-container">
                <div class="bull-icon">
                    <i class="fas fa-gem"></i>
                </div>
                <div class="brand-name">TorroSell</div>
            </div>
            
            <p class="brand-tagline">
                Enterprise Point of Sale System
            </p>

            <div class="feature-list">
                <div class="feature-item">
                    <i class="fas fa-check-circle"></i>
                    <span>Multi-Tenant Architecture</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-check-circle"></i>
                    <span>Inventory Management</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-check-circle"></i>
                    <span>Advanced Reporting</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-check-circle"></i>
                    <span>Real-Time Analytics</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side: Login Form -->
    <div class="login-form-section">
        <div class="login-card">
            <div class="login-header">
                <div class="login-header-logo">
                    <i class="fas fa-gem"></i>
                    <span>TorroSell</span>
                </div>
                <h2>Sign In</h2>
                <p>Enter your credentials to access your account</p>
            </div>

            <div class="form-group">
                <label class="form-label" for="UserName">Username</label>
                <div class="input-group">
                    <i class="fas fa-user"></i>
                    <input type="text" class="form-control" id="UserName" placeholder="Enter your username" required autocomplete="username" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="Password">Password</label>
                <div class="input-group">
                    <i class="fas fa-lock"></i>
                    <input type="password" class="form-control" id="Password" placeholder="Enter your password" required autocomplete="current-password" />
                </div>
            </div>

            <div class="form-options">
                <label class="remember-me">
                    <input type="checkbox" id="RememberMe" /> Remember me
                </label>
                <a href="#" class="forgot-password">Need help?</a>
            </div>

            <button id="btn-login" class="btn-login">
                <i class="fas fa-sign-in-alt"></i> Sign In
            </button>

            <div class="divider">
                <span>Secure Multi-Tenant Login</span>
            </div>
        </div>

        <div class="copyright">
            &copy; @DateTime.Now.Year TorroSell. All rights reserved.
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/Content/plugins/jquery/jquery.min.js"></script>
    <script src="~/Content/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/JqueryLoadingModal/jquery.loadingModal.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        // Loader handlers
        function startLoader() {
            $("body").loadingModal({
                text: 'Authenticating...',
                animation: 'wave',
                backgroundColor: 'rgba(0,0,0,0.8)',
                color: '#fff'
            });
        }
        function stopLoader() {
            $("body").loadingModal('destroy');
        }

        // Toastr config - Dark theme
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            showMethod: "slideDown",
            hideMethod: "fadeOut",
            timeOut: 4000,
            backgroundColor: '#23272a',
            iconColor: '#6272a4'
        };

        // Login logic
        $("#btn-login").click(function () {
            var userName = $("#UserName").val().trim();
            var password = $("#Password").val().trim();

            if (userName === "" || password === "") {
                toastr.error("Please enter both username and password.", "Missing Credentials");
                return;
            }

            var modelData = { UserName: userName, Password: password };
            startLoader();

            $.ajax({
                url: '@Url.Action("Login", "Account")',
                type: "POST",
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(modelData),
                success: function (res) {
                    if (res === "Success") {
                        toastr.success("Welcome to TorroSell! Redirecting...", "Login Successful");
                        setTimeout(function() {
                            window.location.href = "/Home/Index";
                        }, 800);
                    } else {
                        toastr.error(res || "Invalid username or password.", "Login Failed");
                    }
                    stopLoader();
                },
                error: function () {
                    toastr.error("An error occurred while connecting to the server.", "System Error");
                    stopLoader();
                }
            });
        });

        // Allow Enter key to submit
        $(document).keypress(function(e) {
            if(e.which == 13) {
                $("#btn-login").click();
            }
        });
    </script>
</body>
</html>
