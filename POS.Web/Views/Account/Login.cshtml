@using POS.Utilities.ViewModel
@model UserViewModel
@using POS.Utilities.Services
@using POS.Utilities.Utilities
@{
    ViewBag.Title = "Login";
    Layout = null;
    var sdfg = ItemServices.GetCompanyById();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(sdfg != null ? sdfg.CompanyName : "Login")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" rel="stylesheet" />

    <!-- External CSS -->
    <link href="~/Content/assets/css/style.bundle.css" rel="stylesheet" />
    <link href="~/Content/plugins/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/icheck-bootstrap/icheck-bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/dist01/css/adminlte.min.css" rel="stylesheet" />
    <link href="~/Content/JqueryLoadingModal/jquery.loadingModal.min.css" rel="stylesheet" />

    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Poppins', sans-serif;
        }

        #particles-js {
            position: fixed;
            width: 100%;
            height: 100%;
            z-index: -1;
            top: 0;
            left: 0;
            background: #f0f0f5;
        }

        .login-container {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-form {
            background: rgba(255, 255, 255, 0.97);
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 400px;
            animation: fadeSlideIn 1s ease-out forwards;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        }

        @@keyframes fadeSlideIn {
            0% {
                opacity: 0;
                transform: translateY(40px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-form h1 {
            margin-bottom: 20px;
            font-size: 26px;
            font-weight: 700;
            color: #663259;
        }

        .form-control:focus {
            box-shadow: 0 0 8px #8950FC;
            border-color: #8950FC;
        }

        .btn-login {
            background-color: #663259;
            color: white;
            border-radius: 50px;
            padding: 10px 25px;
            font-weight: 600;
            width: 100%;
            transition: transform 0.3s ease, background-color 0.3s ease;
        }

            .btn-login:hover {
                background-color: #8950FC;
                transform: scale(1.05);
            }
    </style>
</head>
<body>
    <div id="particles-js"></div>

    <div class="login-container">
        <div class="login-form text-center">
            @if (sdfg != null)
            {
                <h1>@sdfg.CompanyNameUrdu</h1>
            }
            else
            {
                <h1>POS & Inventory Login</h1>
            }

            <p class="text-muted">Please enter your credentials</p>

            <div class="form-group">
                <input class="form-control" type="text" placeholder="Username" id="UserName" required />
            </div>
            <div class="form-group">
                <input class="form-control" type="password" placeholder="Password" id="Password" required />
            </div>
            <div class="form-group d-flex justify-content-between align-items-center">
                <label><input type="checkbox" /> Remember me</label>
                <a href="#" class="text-secondary">Forgot Password?</a>
            </div>
            <div class="form-group">
                <button id="btn-login" class="btn btn-login">Sign In</button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
    <script src="~/Content/plugins/jquery/jquery.min.js"></script>
    <script src="~/Content/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/dist01/js/adminlte.min.js"></script>
    <script src="~/Content/JqueryLoadingModal/jquery.loadingModal.min.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        // Particle Background
        particlesJS("particles-js", {
            "particles": {
                "number": { "value": 60 },
                "color": { "value": "#663259" },
                "shape": { "type": "circle" },
                "opacity": { "value": 0.5 },
                "size": { "value": 3 },
                "line_linked": {
                    "enable": true,
                    "distance": 120,
                    "color": "#663259",
                    "opacity": 0.4,
                    "width": 1
                },
                "move": {
                    "enable": true,
                    "speed": 1.5
                }
            },
            "interactivity": {
                "detect_on": "canvas",
                "events": {
                    "onhover": { "enable": true, "mode": "repulse" }
                }
            },
            "retina_detect": true
        });

        // Loader handlers
        function startLoader() {
            $("body").loadingModal({ text: 'Logging in...', animation: 'wave' });
        }

        function stopLoader() {
            $("body").loadingModal('destroy');
        }

        // Toastr config
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-center",
            showMethod: "slideDown",
            hideMethod: "fadeOut",
            timeOut: 4000
        };

        // Login logic
        $("#btn-login").click(function () {
            var userName = $("#UserName").val().trim();
            var password = $("#Password").val().trim();

            if (userName === "" || password === "") {
                toastr.error("❌ Username and Password are required.");
                return;
            }

            var modelData = {
                UserName: userName,
                Password: password
            };

            startLoader();

            $.ajax({
                url: '@Url.Action("Login", "Account")',
                type: "POST",
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(modelData),
                success: function (res) {
                    if (res === "Success") {
                        toastr.success("✅ Login successful!");
                        window.location.href = "/Home/Index";
                    } else {
                        toastr.error("❌ Invalid credentials.");
                    }
                    stopLoader();
                },
                error: function () {
                    toastr.error("❌ Server error.");
                    stopLoader();
                }
            });
        });
    </script>
</body>
</html>
