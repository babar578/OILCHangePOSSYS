@using POS.Utilities.Services
@using POS.Utilities.ViewModel
@model ReturnToVendorHeadViewModel
@{
    Layout = null;
    // Data loaded in controller action - not here
    // This prevents tenant context issues during view rendering
}

@using (Html.BeginForm("", "", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    
    <div class="card card-custom">
        <div class="card-header-custom">
            <i class="fas fa-undo-alt"></i>
            <span>Return to Vendor</span>
        </div>
        <div class="card-body" style="padding: 20px;">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-form-label">Transaction Date <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                            </div>
                            @Html.TextBoxFor(m => m.TransactionDate, new { @type = "date", @class = "form-control", min = "1990-05-11", max = "2000-08-20", placeholder = "Transaction Date * ", @required = "true", onkeydown = "return false" })
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-form-label">Doc No</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-file-alt"></i></span>
                            </div>
                            @Html.TextBoxFor(m => m.DocNo, new { @class = "form-control", placeholder = "DocNo ", @required = "true" })
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-form-label">Vendor <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.VendorId, new SelectList(Model.Vendors, "Id", "VendorName"), new { @class = "form-control selectpicker", data_live_search = "true", data_hide_disabled = "true", title = "Select Vendor", @required = "true" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="col-form-label">Remarks</label>
                        @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control", placeholder = "Enter Remarks", @required = "true" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-form-label">Add Item</label>
                        <div class="input-group">
                            @Html.DropDownListFor(m => m.ItemStocks, "ItemId", "ItemName"), new { @class = "form-control selectpicker", data_live_search = "true", data_hide_disabled = "true", title = "Select Item to Return", @required = "true" })
                            <div class="input-group-append">
                                <button type="button" id="btnImport" class="btn btn-primary"><i class="fas fa-plus"></i> Import</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="col-form-label">&nbsp;</label>
                        <button type="button" onclick="ReturnToVendor()" class="btn btn-block btn-danger btn-action shadow-sm"><i class="fas fa-save"></i> SAVE</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    $(document).ready(function () {
        $('select').selectpicker();
    });

    var today = new Date();
    var min = today.getMonth() + 1;
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();
    if (dd < 10) {
        dd = '0' + dd
    }
    if (mm < 10) {
        mm = '0' + mm
    }

    today = yyyy + '-' + mm + '-' + dd;
    document.getElementById("TransactionDate").setAttribute("max", today);
    min = yyyy + '-' + mm + '-' + dd;
    document.getElementById("TransactionDate").setAttribute("min", min);



    $("#btnImport").click(function () {
        var itemId = $("#ItemId").val();
        startLoader();
        $.ajax(
            {
                url: "/Inventory/SearchReturnToVendorItem?ItemId=" + itemId,
                type: "POST"
            }
        ).done(function (result) {
            ReturnToVendorDetail();
            stopLoader();
        });
    });

</script>
