@using POS.Utilities.Services
@using POS.Utilities.ViewModel
@model VendorToWarehouseHeadViewModel
@{

    Layout = null;
    Model.Vendors = VendorServices.GetAllVendors();
    Model.RawItems = ItemServices.GetAllItems(true);

}

@using (Html.BeginForm("", "", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    
    <div class="card card-custom">
        <div class="card-header-custom">
            <i class="fas fa-truck-loading"></i>
            <span>Vendor To Warehouse (Purchase)</span>
        </div>
        <div class="card-body" style="padding: 20px;">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-form-label">Transaction Date <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                            </div>
                            @Html.TextBoxFor(m => m.TransactionDate, new { @type = "date", @class = "form-control", min = "2021-08-01", max = "2021-08-20", placeholder = "Transaction Date * ", @required = "true", onkeydown = "return false" })
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-form-label">Doc No</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-file-alt"></i></span>
                            </div>
                            @Html.TextBoxFor(m => m.DocNo, new { @class = "form-control", placeholder = "DocNo ", @required = "true" })
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-form-label">Vendor Name <span class="text-danger">*</span></label>
                         @Html.DropDownListFor(m => m.VendorId, new SelectList(Model.Vendors, "Id", "VendorName"), new { @class = "form-control selectpicker", data_live_search = "true", data_hide_disabled = "true", title = "Select Vendor", @required = "true" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label class="col-form-label">Remarks</label>
                        @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control", placeholder = "Enter Remarks", @required = "true" })
                    </div>
                </div>
                 <div class="col-md-4">
                     <div class="form-group">
                        <label class="col-form-label">Add Item</label>
                        <div class="input-group">
                            @Html.DropDownListFor(m => m.ItemId, new SelectList(Model.RawItems, "Id", "Name"), new { @class = "form-control selectpicker", data_live_search = "true", data_hide_disabled = "true", title = "Select Item to Import", @required = "true" })
                            <div class="input-group-append">
                                <button type="button" id="btnImport" class="btn btn-primary"><i class="fas fa-plus"></i> Import</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
             <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="col-form-label">Barcode Scan</label>
                        <div class="input-group">
                             <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                            </div>
                            @Html.TextBoxFor(m => m.RawItemss.Barcode, new { @class = "form-control", placeholder = "Scan Barcode Here...", @required = "true", @id = "btnImportbarcode", autocomplete="off" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<script language="JavaScript" type="text/javascript" src="/js/jquery-1.2.6.min.js"></script>
<script language="JavaScript" type="text/javascript" src="/js/jquery-ui-personalized-1.5.2.packed.js"></script>
<script language="JavaScript" type="text/javascript" src="/js/sprinkle.js"></script>
<script>
    $(document).ready(function () {
        $('select').selectpicker();

    });
    $(document).ready(function () {
        // Auto-focus the barcode input field when the page loads
        $('#btnImportbarcode').focus();

        // Handle the Enter key press event
        $('#btnImportbarcode').on('keypress', function (e) {
            if (e.which == 13) { // Enter key pressed
                e.preventDefault(); // Prevent the default form submission
                // Trigger the AJAX call
                handleBarcodeScan();
            }
        });

    $(function () {
        debugger
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!
        var yyyy = today.getFullYear();
        if (dd < 10) {
            dd = '0' + dd
        }
        if (mm < 10) {
            mm = '0' + mm
        }

        today = yyyy + '-' + mm + '-' + dd;
        document.getElementById("TransactionDate").setAttribute("max", today);
    });

    $("#btnImport").click(function () {
        debugger
        var itemId = $("#ItemId").val();
        startLoader();
        $.ajax(
            {
                url: "/Inventory/SearchItem?ItemId=" + itemId,
                type: "POST"
            }
        ).done(function (result) {
            VendorToWarehouseDetail();
            stopLoader();
        });
    });

        function handleBarcodeScan() {
            debugger
            var Barcode = $("#btnImportbarcode").val();
            startLoader();
            $.ajax({
                url: "/Inventory/SearchBarcodeItem?Barcode=" + Barcode,
                type: "POST"
            }).done(function (result) {
                debugger
                VendorToWarehouseDetail();
                $("#btnImportbarcode").val('');
                stopLoader();
            });
        }

        // Function to start the loader (you should define this)
    

        // Function to handle additional details (you should define this)
  
    });
