    function RemoveVendorToWarehouse(itemId) {
         startLoader();
            $.ajax({
                url: '@Url.Action("DeleteVendorToWarehouse", "Inventory")',
                type: "POST",
                data: { ItemId: itemId},
            }).done(function (res) {
                VendorToWarehouseDetail();
                stopLoader();
            });
    }


</script>

