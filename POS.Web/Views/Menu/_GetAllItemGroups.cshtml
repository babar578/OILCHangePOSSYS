@using POS.Utilities.ViewModel
@model IEnumerable<ItemGroupViewModel>
@{
    Layout = null;
}
<script src="~/Scripts/Site.js"></script>

<style>
    .item-groups-container {
        padding: 20px;
    }
    .empty-groups {
        text-align: center;
        padding: 60px 20px;
        color: #718096;
    }
    .empty-groups i {
        font-size: 64px;
        color: #cbd5e0;
        margin-bottom: 20px;
    }
</style>

<div class="item-groups-container">
    <div class="row">
        <div class="col-12">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h3><i class="fas fa-layer-group"></i> Item Groups Management</h3>
                    <a href="/Menu/ItemGroup" id="btn-add"
                       class="btn-modern-primary"
                       data-toggle="tooltip" data-placement="bottom" title="Add New Item Group"
                       data-caption="Add New Item Group">
                        <i class="fas fa-plus"></i> Add New Item Group
                    </a>
                </div>
                <div class="modern-table-wrapper">
                    @if (Model != null && Model.Count() > 0)
                    {
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Group Name</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model)
                                {
                                    <tr class="dgrow" data-id="@e.Id">
                                        <td>@e.Id</td>
                                        <td><strong>@e.Name</strong></td>
                                        <td>
                                            <div class="action-buttons">
                                                <a href="/Menu/ItemGroup/@e.Id" class="action-btn-edit" data-toggle="tooltip" data-placement="bottom" title="Edit Item Group">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <a href="/Menu/DeleteItemGroup/@e.Id" class="action-btn-delete" data-toggle="tooltip" data-placement="bottom" title="Delete Item Group">
                                                    <i class="fas fa-trash"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-groups">
                            <i class="fas fa-layer-group"></i>
                            <h4>No Item Groups Found</h4>
                            <p>Get started by adding your first item group.</p>
                            <a href="/Menu/ItemGroup" class="btn-modern-primary" style="margin-top: 20px;">
                                <i class="fas fa-plus"></i> Add Item Group
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
