@using POS.Utilities.ViewModel
@model IEnumerable<UnitViewModel>
@{
    ViewBag.Title = "Units";
    var searchKeyword = ViewBag.search;
}

<style>
    .units-page {
        padding: 20px;
    }
    .empty-units {
        text-align: center;
        padding: 60px 20px;
        color: #718096;
    }
    .empty-units i {
        font-size: 64px;
        color: #cbd5e0;
        margin-bottom: 20px;
    }
</style>

<div class="units-page">
    <div class="row">
        <div class="col-12">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h3><i class="fas fa-ruler"></i> Units Management</h3>
                    <a href="/Menu/Unit" id="btn-add"
                       class="btn-modern-primary"
                       data-toggle="tooltip" data-placement="bottom" title="Add New Unit"
                       data-caption="Add New Unit">
                        <i class="fas fa-plus"></i> Add New Unit
                    </a>
                </div>
                <div class="modern-table-wrapper">
                    @if (Model != null && Model.Count() > 0)
                    {
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Unit Name</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model)
                                {
                                    <tr class="dgrow" data-id="@e.Id">
                                        <td>@e.Id</td>
                                        <td><strong>@e.Name</strong></td>
                                        <td>
                                            <div class="action-buttons">
                                                <a href="/Menu/Unit/@e.Id" class="action-btn-edit" data-toggle="tooltip" data-placement="bottom" title="Edit Unit">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <a href="/Menu/DeleteUnit/@e.Id" class="action-btn-delete" data-toggle="tooltip" data-placement="bottom" title="Delete Unit">
                                                    <i class="fas fa-trash"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-units">
                            <i class="fas fa-ruler"></i>
                            <h4>No Units Found</h4>
                            <p>Get started by adding your first unit.</p>
                            <a href="/Menu/Unit" class="btn-modern-primary" style="margin-top: 20px;">
                                <i class="fas fa-plus"></i> Add Unit
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
