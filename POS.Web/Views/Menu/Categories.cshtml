@using POS.Utilities.ViewModel
@model IEnumerable<CategoryViewModel>
@{
    ViewBag.Title = "Categories";
    var searchKeyword = ViewBag.search;
}

<style>
    .categories-page {
        padding: 20px;
    }
    .empty-categories {
        text-align: center;
        padding: 60px 20px;
        color: #718096;
    }
    .empty-categories i {
        font-size: 64px;
        color: #cbd5e0;
        margin-bottom: 20px;
    }
</style>

<div class="categories-page">
    <div class="row">
        <div class="col-12">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h3><i class="fas fa-tags"></i> Categories Management</h3>
                    <a href="/Menu/Category" id="btn-add"
                       class="btn-modern-primary"
                       data-toggle="tooltip" data-placement="bottom" title="Add New Category"
                       data-caption="Add New Category">
                        <i class="fas fa-plus"></i> Add New Category
                    </a>
                </div>
                <div class="modern-table-wrapper">
                    @if (Model != null && Model.Count() > 0)
                    {
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Category Name</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model)
                                {
                                    <tr class="dgrow" data-id="@e.Id">
                                        <td>@e.Id</td>
                                        <td><strong>@e.Name</strong></td>
                                        <td>
                                            <div class="action-buttons">
                                                <a href="/Menu/Category/@e.Id" class="action-btn-edit" data-toggle="tooltip" data-placement="bottom" title="Edit Category">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <a href="/Menu/DeleteCategory/@e.Id" class="action-btn-delete" data-toggle="tooltip" data-placement="bottom" title="Delete Category">
                                                    <i class="fas fa-trash"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-categories">
                            <i class="fas fa-tags"></i>
                            <h4>No Categories Found</h4>
                            <p>Get started by adding your first category.</p>
                            <a href="/Menu/Category" class="btn-modern-primary" style="margin-top: 20px;">
                                <i class="fas fa-plus"></i> Add Category
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

