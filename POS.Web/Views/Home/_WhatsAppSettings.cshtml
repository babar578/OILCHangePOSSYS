@model POS.Utilities.ViewModel.WhatsAppSettingsViewModel

@{
    Layout = null;
}

<div class="whatsapp-settings-form">
    <form id="whatsappSettingsForm">
        @Html.HiddenFor(m => m.Id)
        
        <div class="form-group">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <label class="form-label font-weight-bold">WhatsApp Service Status</label>
                <div class="custom-control custom-switch">
                    <input type="checkbox" class="custom-control-input" id="whatsappEnabled" @(Model.IsEnabled ? "checked" : "")>
                    <label class="custom-control-label" for="whatsappEnabled">
                        <span id="whatsappStatusText">@(Model.IsEnabled ? "Enabled" : "Disabled")</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Provider Name <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.ProviderName, new { @class = "form-control", @required = "required" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>API URL <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.ApiUrl, new { @class = "form-control", @required = "required", @placeholder = "https://api.whatsapp.com/v1" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Phone Number</label>
                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", @placeholder = "923428513077" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Sender Number</label>
                    @Html.TextBoxFor(m => m.SenderNumber, new { @class = "form-control", @placeholder = "923428513077" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>API Key</label>
                    @Html.TextBoxFor(m => m.ApiKey, new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>API Token</label>
                    @Html.TextBoxFor(m => m.ApiToken, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Instance ID</label>
                    @Html.TextBoxFor(m => m.InstanceId, new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Access Token</label>
                    @Html.TextBoxFor(m => m.AccessToken, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Additional Configuration (JSON)</label>
            @Html.TextAreaFor(m => m.AdditionalConfig, new { @class = "form-control", @rows = "3", @placeholder = "{\"key\": \"value\"}" })
        </div>

        <div class="form-group text-right">
            <button type="button" class="btn btn-primary" onclick="SaveWhatsAppSettings()">
                <i class="fas fa-save"></i> Save WhatsApp Settings
            </button>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {
        // Toggle WhatsApp enabled/disabled
        $('#whatsappEnabled').change(function () {
            var isEnabled = $(this).is(':checked');
            $('#whatsappStatusText').text(isEnabled ? 'Enabled' : 'Disabled');
            
            // Save toggle state immediately
            $.ajax({
                url: '/Home/ToggleWhatsApp',
                type: 'POST',
                data: { isEnabled: isEnabled },
                success: function (response) {
                    if (response === 'Success') {
                        alertify.success('WhatsApp service ' + (isEnabled ? 'enabled' : 'disabled') + ' successfully');
                    } else {
                        alertify.error('Error updating WhatsApp status');
                        $('#whatsappEnabled').prop('checked', !isEnabled);
                        $('#whatsappStatusText').text(!isEnabled ? 'Enabled' : 'Disabled');
                    }
                },
                error: function () {
                    alertify.error('Error updating WhatsApp status');
                    $('#whatsappEnabled').prop('checked', !isEnabled);
                    $('#whatsappStatusText').text(!isEnabled ? 'Enabled' : 'Disabled');
                }
            });
        });
    });

    function SaveWhatsAppSettings() {
        var formData = $('#whatsappSettingsForm').serialize();
        var isEnabled = $('#whatsappEnabled').is(':checked');
        
        // Add IsEnabled to form data
        formData += '&IsEnabled=' + isEnabled;
        
        startLoader();
        $.ajax({
            url: '/Home/SaveWhatsAppSettings',
            type: 'POST',
            data: formData,
            success: function (response) {
                stopLoader();
                if (response === 'Success') {
                    alertify.success('WhatsApp settings saved successfully');
                } else {
                    alertify.error('Error saving WhatsApp settings: ' + response);
                }
            },
            error: function () {
                stopLoader();
                alertify.error('Error saving WhatsApp settings');
            }
        });
    }
</script>

