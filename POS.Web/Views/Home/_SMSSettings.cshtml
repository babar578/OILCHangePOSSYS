@model POS.Utilities.ViewModel.SMSSettingsViewModel

@{
    Layout = null;
}

<div class="sms-settings-form">
    <form id="smsSettingsForm">
        @Html.HiddenFor(m => m.Id)
        
        <div class="form-group">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <label class="form-label font-weight-bold">SMS Service Status</label>
                <div class="custom-control custom-switch">
                    <input type="checkbox" class="custom-control-input" id="smsEnabled" @(Model.IsEnabled ? "checked" : "")>
                    <label class="custom-control-label" for="smsEnabled">
                        <span id="smsStatusText">@(Model.IsEnabled ? "Enabled" : "Disabled")</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Provider Name <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.ProviderName, new { @class = "form-control", @required = "required" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>API URL <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.ApiUrl, new { @class = "form-control", @required = "required", @placeholder = "https://telenorcsms.com.pk:27677/corporate_sms2/api" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Username / MSISDN <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control", @required = "required", @placeholder = "923428513077" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Password <span class="text-danger">*</span></label>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", @required = "required", @value = Model.Password })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Sender Number</label>
                    @Html.TextBoxFor(m => m.SenderNumber, new { @class = "form-control", @placeholder = "923428513077" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Sender ID / Mask</label>
                    @Html.TextBoxFor(m => m.Mask, new { @class = "form-control", @placeholder = "Shahzad Oil" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>API Key</label>
                    @Html.TextBoxFor(m => m.ApiKey, new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>API Token</label>
                    @Html.TextBoxFor(m => m.ApiToken, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Additional Configuration (JSON)</label>
            @Html.TextAreaFor(m => m.AdditionalConfig, new { @class = "form-control", @rows = "3", @placeholder = "{\"key\": \"value\"}" })
        </div>

        <div class="form-group text-right">
            <button type="button" class="btn btn-primary" onclick="SaveSMSSettings()">
                <i class="fas fa-save"></i> Save SMS Settings
            </button>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {
        // Toggle SMS enabled/disabled
        $('#smsEnabled').change(function () {
            var isEnabled = $(this).is(':checked');
            $('#smsStatusText').text(isEnabled ? 'Enabled' : 'Disabled');
            
            // Save toggle state immediately
            $.ajax({
                url: '/Home/ToggleSMS',
                type: 'POST',
                data: { isEnabled: isEnabled },
                success: function (response) {
                    if (response === 'Success') {
                        alertify.success('SMS service ' + (isEnabled ? 'enabled' : 'disabled') + ' successfully');
                    } else {
                        alertify.error('Error updating SMS status');
                        $('#smsEnabled').prop('checked', !isEnabled);
                        $('#smsStatusText').text(!isEnabled ? 'Enabled' : 'Disabled');
                    }
                },
                error: function () {
                    alertify.error('Error updating SMS status');
                    $('#smsEnabled').prop('checked', !isEnabled);
                    $('#smsStatusText').text(!isEnabled ? 'Enabled' : 'Disabled');
                }
            });
        });
    });

    function SaveSMSSettings() {
        var formData = $('#smsSettingsForm').serialize();
        var isEnabled = $('#smsEnabled').is(':checked');
        
        // Add IsEnabled to form data
        formData += '&IsEnabled=' + isEnabled;
        
        startLoader();
        $.ajax({
            url: '/Home/SaveSMSSettings',
            type: 'POST',
            data: formData,
            success: function (response) {
                stopLoader();
                if (response === 'Success') {
                    alertify.success('SMS settings saved successfully');
                } else {
                    alertify.error('Error saving SMS settings: ' + response);
                }
            },
            error: function () {
                stopLoader();
                alertify.error('Error saving SMS settings');
            }
        });
    }
</script>

