@using POS.Utilities.Services
@using POS.Utilities.ViewModel
@model OrderViewModel

@{
    Layout = null;
    var company = ItemServices.GetCompanyById();
    var printDate = (Model.CreationDate ?? DateTime.Now).ToString("dd/MM/yy");
    var oilName = string.IsNullOrWhiteSpace(Model.OilItemName) ? "Oil" : Model.OilItemName;
    var phone = !string.IsNullOrWhiteSpace(company.PhoneNumber2) ? company.PhoneNumber2 : company.PhoneNumber1;
}

<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reading Sticker</title>
    <style>
        @@page {
            size: 2in 1in;
            margin: 0;
        }
        html, body {
            width: 2in;
            height: 1in;
            margin: 0;
            padding: 0;
        }
        .sticker {
            box-sizing: border-box;
            width: 2in;
            height: 1in;
            padding: 0.06in;
            font-family: Arial, sans-serif;
            color: #000;
            overflow: hidden;
        }
        .readings {
            display: flex;
            justify-content: space-between;
            line-height: 1;
        }
        .reading {
            width: 49%;
            text-align: center;
        }
        .reading span {
            display: block;
            font-size: 9px;
            font-weight: 700;
        }
        .reading strong {
            display: block;
            font-size: 22px;
            font-weight: 900;
        }
        .meta {
            display: grid;
            grid-template-columns: 1fr 1fr;
            column-gap: 0.05in;
            margin-top: 0.02in;
            font-size: 8px;
            font-weight: 700;
            line-height: 1.15;
            white-space: nowrap;
        }
        .visit {
            margin-top: 0.02in;
            font-size: 8px;
            font-weight: 800;
            line-height: 1;
            text-align: center;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <div class="sticker">
        <div class="readings">
            <div class="reading"><span>Current</span><strong>@Model.CurrentReading</strong></div>
            <div class="reading"><span>Next</span><strong>@Model.NextReading</strong></div>
        </div>
        <div class="meta">
            <span>Oil: @oilName</span>
            <span>Car: @Model.CarNo</span>
            <span>Ph: @phone</span>
            <span>Date: @printDate</span>
        </div>
        <div class="visit">Come and visit Shahzada store.</div>
    </div>

    <script>
        // Auto-print when opened in a new window
        window.onload = function () {
            window.focus();
            window.print();
        };
    </script>
</body>
</html>

